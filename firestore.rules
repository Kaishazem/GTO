rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if the requesting user is an admin ──────────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Helper: check the user is authenticated ───────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ── users/{userId} ────────────────────────────────────────────────────
    // Users can read/write their own document; admins can read/write all.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // ── tasks/{taskId} ────────────────────────────────────────────────────
    // Public read (unauthenticated browsing); admins may write anything.
    // Server-side import handlers may CREATE platform tasks without auth —
    // they must set importedFrom and taskType == 'platform'.
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (request.resource.data.importedFrom != null &&
         request.resource.data.taskType == 'platform');
      allow update, delete: if isAdmin();
    }

    // ── taskCompletions/{completionId} ────────────────────────────────────
    // Authenticated users can create completions for themselves.
    // Users can read their own; admins can read/write all.
    match /taskCompletions/{completionId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── payouts/{payoutId} ───────────────────────────────────────────────
    // Users can create and read their own payout requests; admins manage all.
    match /payouts/{payoutId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── stats/{statId} ────────────────────────────────────────────────────
    // Authenticated users can read; only admins write.
    match /stats/{statId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── device_fingerprints/{fpId} ────────────────────────────────────────
    // Written during registration (unauthenticated at that moment) and by admins.
    // Only admins may read the full collection.
    match /device_fingerprints/{fpId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── banned_devices/{banId} ────────────────────────────────────────────
    // Any authenticated user needs to read this to check their own ban status.
    // Only admins may write.
    match /banned_devices/{banId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── banned_emails/{email} ─────────────────────────────────────────────
    // ANYONE (including unauthenticated) may read — required so Login and
    // Register pages can check before the user is signed in.
    // Only admins may write / delete.
    match /banned_emails/{email} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── settings/{docId} ─────────────────────────────────────────────────
    // Authenticated users can read settings (needed for task/withdrawal config).
    // Only admins may write.
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── platforms/{platformId} ─────────────────────────────────────────────
    // Public read required — server-side import handlers call Firestore REST
    // without a user auth token and must be able to read platform config.
    // Only admins may create, delete, or change config fields.
    // Server-side handlers may update import-status fields without auth.
    match /platforms/{platformId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['importStatus', 'lastImportAt', 'lastImportCount',
                    'totalOffersFound', 'lastImportDurationMs', 'lastError',
                    'apiBase', 'endpoint', 'authenticationType', 'responsePath',
                    'apiKey', 'displayName', 'name', 'queryParameters']);
    }

    // ── walletTransactions/{txId} ──────────────────────────────────────────
    // Users can read their own wallet transaction logs; admins can read/write all.
    // Server-side postback handler also writes wallet transactions (unauthenticated REST).
    match /walletTransactions/{txId} {
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── postbackConversions/{convId} ───────────────────────────────────────
    // Written by the server-side postback API (unauthenticated REST with API key).
    // Admins can read and write for monitoring; users have no access.
    match /postbackConversions/{convId} {
      allow read, write: if isAdmin();
    }

    // ── postbackLogs/{logId} ───────────────────────────────────────────────
    // Full audit trail of every received postback, including rejections.
    // Written server-side; admins can read for monitoring.
    match /postbackLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // ── withdrawals/{withdrawalId} ─────────────────────────────────────────
    // Users can create and read their own withdrawal requests; admins manage all.
    match /withdrawals/{withdrawalId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── adminAlerts/{alertId} ──────────────────────────────────────────────
    // Users can create alerts about themselves (fraud detection); admins manage all.
    match /adminAlerts/{alertId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── notifications/{notifId} ────────────────────────────────────────────
    // Notifications are keyed by a deterministic ID (userId_dedupeKey).
    // Users can create their own notifications and read/update (mark read/delete) them.
    // Admins can read and manage all.
    match /notifications/{notifId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // resource == null handles getDoc on non-existent docs: Firestore evaluates
      // resource.data on null which throws in the rule engine → permission-denied.
      // The null guard lets the existence check succeed and return {exists:false}.
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ── systemMessages/{msgId} ─────────────────────────────────────────────
    // Admin-broadcast messages that trigger notifications for all users.
    // Authenticated users can read (to detect new messages via realtime listener).
    // Only admins may create, update, or delete.
    match /systemMessages/{msgId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
